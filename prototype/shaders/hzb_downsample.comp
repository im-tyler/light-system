#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform HzbParams {
    uint src_width;
    uint src_height;
} params;

layout(set = 0, binding = 0) uniform sampler2D src_mip;
layout(set = 0, binding = 1, r32f) writeonly uniform image2D dst_mip;

void main() {
    ivec2 dst_coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dst_size = imageSize(dst_mip);
    if (dst_coord.x >= dst_size.x || dst_coord.y >= dst_size.y) return;

    // Mip extents are floor(src/2), so a fixed 2x2 tap grid never covers odd
    // source edges (src 5 -> dst 2 leaves source column 4 unsampled; a lost
    // far-depth texel breaks conservative rejection). Instead reduce over the
    // exact footprint this destination texel represents: src range
    // [floor(d*S/D), floor((d+1)*S/D)-1] per axis. Each source texel maps to
    // exactly one destination texel, footprints span 2..3 texels per axis at
    // odd edges (S/D <= 2 + rounding under floor halving), and the reduce
    // stays a pure max over covered texels.
    ivec2 src_size = ivec2(params.src_width, params.src_height);
    ivec2 base = (dst_coord * src_size) / dst_size;
    ivec2 end = min(((dst_coord + 1) * src_size) / dst_size - 1, src_size - 1);

    float max_depth = 0.0;
    for (int y = base.y; y <= end.y; ++y) {
        for (int x = base.x; x <= end.x; ++x) {
            max_depth = max(max_depth, texelFetch(src_mip, ivec2(x, y), 0).r);
        }
    }
    imageStore(dst_mip, dst_coord, vec4(max_depth));
}
